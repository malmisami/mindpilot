# --- Välituki ------------------------------------------------------------------------------------------------------
# LIVE_AI_MODE (default): Claude phrases the chat replies, the guided CBT questions and the other bounded support texts. Requires
# ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN); without it the app falls back to DEMO_AI_MODE automatically. A key added
# here while the server runs is picked up by the demo dock's AI switch ("Claude" / "Testaa") – no restart needed.
# DEMO_AI_MODE: deterministic, pre-approved texts – no API key needed.
# Never commit a real key.
VALITUKI_AI_MODE=LIVE_AI_MODE
VALITUKI_AI_MODEL=claude-opus-5
VALITUKI_AI_TIMEOUT_SECONDS=30
# ANTHROPIC_API_KEY=
# Who answers in LIVE_AI_MODE: anthropic (Claude, default) or openai = any OpenAI-compatible server, e.g. vLLM on an AMD
# GPU. Through an SSH tunnel (ssh -N -L 8000:127.0.0.1:8000 root@<gpu-ip>) the address is http://127.0.0.1:8000/v1.
# The model may be left empty: the server's first model is used. The key is the one given to vllm serve --api-key.
# VALITUKI_AI_PROVIDER=openai
# VALITUKI_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# VALITUKI_OPENAI_MODEL=
# VALITUKI_OPENAI_API_KEY=
# VALITUKI_OPENAI_LABEL=AMD GPU
VALITUKI_STATE_PATH=runtime/valituki/state.json
VALITUKI_DATA_DIR=data/valituki
ALLOWED_ORIGINS=http://localhost:5195,http://127.0.0.1:5195

# --- Legacy OmaGenomi features (hidden) -----------------------------------------------------------------------------
# 1 = mount the earlier DNA analysis / genetic-risk / care-plan / Apple Health API routes again.
# The legacy frontend additionally needs VITE_ENABLE_LEGACY_APP=true at build/dev time.
LEGACY_FEATURES_ENABLED=0
OMAGENOMI_MODE=auto
LOOP_LLM_PROVIDER=off
LOOP_LLM_MODEL=claude-opus-5
LOOP_STATE_PATH=runtime/loop/state.json
SESSION_ROOT=runtime/sessions
