        "\\btapan itseni",
        "\\btappaa itseni",
        "\\bitsemurh",
        "\\ben (halua|jaksa) (enaa )?elaa",
        "\\blopettaa (tama |koko )?elamani",
        "\\bpaattaa elamani",
        "\\bparempi (olisi )?(jos )?(olisin )?kuollut",
        "\\bolisi parempi olla kuollut",
        "\\bkaikki olisivat paremmin ilman minua",
        "\\bei ole (enaa )?syyta elaa"
      ]
    },
